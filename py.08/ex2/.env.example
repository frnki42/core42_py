# Mode: "development" or "production"
MATRIX_MODE=development

# Database: Connection string for data storage
DATABASE_URL=sqlite:///matrix_dev.db

# API key: Secret key for external services - replace with your own, never commit it.
API_KEY=your_api_key_here

# Logging verbosity: DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=DEBUG

# URL of the Zion resistance network
ZION_ENDPOINT=http://localhost:8000/zion
